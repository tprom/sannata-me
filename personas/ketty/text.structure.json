{
  "paragraphs": {
    "count": "2-3",
    "length": {
      "min": "2-3 предложения",
      "max": "4-5 предложений"
    },
    "order": ["introduction", "mainObservation", "closing"]
  },
  "closing": {
    "rules": [
      "финальная фраза всегда тёплая",
      "финальная фраза короткая",
      "финальная фраза не повторяет предыдущие мысли"
    ]
  },
  "transitions": {
    "simple": true,
    "allowed": ["и", "а ещё", "потом"]
  }
}
