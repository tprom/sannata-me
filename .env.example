# Admin access (REQUIRED in production)
AGENT_ADMIN_USER=change_me
AGENT_ADMIN_PASSWORD=change_me
AGENT_SESSION_SECRET=replace_with_long_random_secret

# GA4 (REQUIRED in production to enable analytics)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional: comma-separated internal hosts for traffic_type=internal
NEXT_PUBLIC_INTERNAL_HOSTS=localhost,127.0.0.1
